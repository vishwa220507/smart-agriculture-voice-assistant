# Required for Gemini AI text and Live API responses
GEMINI_API_KEY=your_gemini_api_key_here
# Text requests use a normal generate_content model.
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Live audio uses a separate bidirectional streaming model.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Optional. Leave blank to use the safe offline fallback.
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
MARKET_API_KEY=your_market_api_key_here
MARKET_API_URL=https://api.example.com/market-prices
